    "**/node_modules/**", "**/.git/**", "**/vendor/**", "**/third_party/**",
    "**/dist/**", "**/build/**", "**/target/**", "**/.zig-cache/**",
    "**/zig-out/**", "**/coverage/**", "**/__pycache__/**",
    "**/*.env", "**/*.env.*", "**/*secret*", "**/*credential*", "**/*.pem",
    "**/*id_rsa*", "**/.npmrc", "**/.ssh/**"
  ],
