{
  "schema": "REPO-CORPUS-v1",
  "note": "Declared Academy harvest sources. class: first_party = fleet-owned projects; upstream = donor/fork corpora (provenance-labeled). mode: local = live clone under $HOME; pinned_clone = checkout under ~/.academy-corpus pinned to a recorded sha; declassified = public copies inside the repo (drawer originals never harvest). Private/local-only trees are excluded entirely by owner decision.",
  "global_exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/vendor/**",
    "**/third_party/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/.zig-cache/**",
    "**/zig-out/**",
    "**/coverage/**",
    "**/__pycache__/**",
    "**/*.env",
    "**/*.env.*",
    "**/*secret*",
    "**/*credential*",
    "**/*.pem",
    "**/*id_rsa*",
    "**/.npmrc",
    "**/.ssh/**"
  ],
  "global_include": [
    "**/*.md",
    "**/*.markdown",
    "**/*.txt",
    "**/*.rst"
  ],
